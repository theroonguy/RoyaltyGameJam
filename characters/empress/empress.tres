[sub_resource type="Resource" id="Resource_bic83"]
script = ExtResource("1_c33si")
text = "Cruel, filthy imposter. You’ve taken advantage of a moment of weakness to try to impersonate my dear lost daughter, and for that, you’ll pay the price."
next = SubResource("Resource_qm7lt")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_ghfw3"]
script = ExtResource("1_c33si")
text = "My daughter… it truly is you. You’ve come back! At last! My daily nightmares of that day, and you’ve finally come back to us. Oh, how I’ve missed you so. Please, go meet your father."
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_nkinp"]
script = ExtResource("3_03vy3")
success = SubResource("Resource_ghfw3")
failure = SubResource("Resource_bic83")
