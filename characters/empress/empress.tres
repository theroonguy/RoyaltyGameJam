[sub_resource type="Resource" id="Resource_1j7bm"]
script = ExtResource("1_c33si")
text = "Why have you returned?"
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_y1yqk"]
script = ExtResource("2_1hgpb")
text1 = "I do not have much memory of my past. I only remember a fire in the early stages of my youth, but I was raised by a rural family in the mountainside."
option1 = SubResource("Resource_1j7bm")
text2 = "I was adopted by a foster family, but I clearly remember my roots in this kingdom."
metadata/_custom_type_script = "uid://uc8ep36gysp7"

[sub_resource type="Resource" id="Resource_jknef"]
script = ExtResource("1_c33si")
text = "Name it. But reveal your identity. You seem... familiar. I need to know before we proceed."
next = SubResource("Resource_y1yqk")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_f1ljg"]
script = ExtResource("2_1hgpb")
text1 = "I do have information... but only for a price."
option1 = SubResource("Resource_jknef")
text2 = "What... do you want to know?"
metadata/_custom_type_script = "uid://uc8ep36gysp7"

[sub_resource type="Resource" id="Resource_y7xir"]
script = ExtResource("1_c33si")
text = "I was told you had information about the affair. Wait... who are you?"
next = SubResource("Resource_f1ljg")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[resource]
