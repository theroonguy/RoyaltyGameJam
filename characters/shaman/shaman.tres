[sub_resource type="Resource" id="Resource_e3ykk"]
script = ExtResource("3_fcw2k")
text = "Use your connections wisely before they dry up. All it takes it playing the wrong card to lose your life.

Take this letter and deliver it to Consort Li. She will know what to do."
next = SubResource("Resource_5n22f")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_lu4u5"]
script = ExtResource("3_fcw2k")
text = "You have the face, the posture. You just may have what it takes to gain the Emperor's trust and get close enough to his throat. But it won't be easy; you only have 3 days before you're bound to be caught."
next = SubResource("Resource_e3ykk")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_oi53t"]
script = ExtResource("3_fcw2k")
text = "15 years... a fire in the night was all it took to lose the precious [protagonist name]. They looked under every stone, and atop every peak. But they never thought to look across the border."
next = SubResource("Resource_lu4u5")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_cyt25"]
script = ExtResource("3_fcw2k")
text = "Ah, yes, I have seen these crossing the boundaries of this Kingdom under even the most watchful eyes.."
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

