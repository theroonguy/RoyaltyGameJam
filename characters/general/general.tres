metadata/_custom_type_script = "uid://3qpgq1q2rc7j"

[sub_resource type="Resource" id="Resource_e3oo0"]
script = ExtResource("2_8tmwt")
card = ExtResource("1_kq8pr")
next = SubResource("Resource_82m1w")
metadata/_custom_type_script = "uid://3qpgq1q2rc7j"

[sub_resource type="Resource" id="Resource_oh7gt"]
script = ExtResource("2_buo7l")
text = "Oh- oh no. You weren't supposed to see that. You'll stay silent, right?"
next = SubResource("Resource_e3oo0")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_viybm"]
script = ExtResource("5_kq8pr")
text = "Something colorful and shiny drops out of General Yue's pockets!"
next = SubResource("Resource_oh7gt")
metadata/_custom_type_script = "uid://8ly55p71e14f"

[sub_resource type="Resource" id="Resource_pdkiw"]
script = ExtResource("2_buo7l")
text = "We'll have to conduct a bag search if you want to proceed."
next = SubResource("Resource_viybm")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_i30dq"]
script = ExtResource("6_4ivqm")
text1 = "I'm someone passing through."
option1 = SubResource("Resource_pdkiw")
text2 = "I'm simply exploring the kingdom."
option2 = SubResource("Resource_pdkiw")
metadata/_custom_type_script = "uid://uc8ep36gysp7"

[sub_resource type="Resource" id="Resource_fdejs"]
script = ExtResource("2_buo7l")
text = "Halt! What brings you to the outer palace?"
next = SubResource("Resource_i30dq")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_ekwo1"]
script = ExtResource("2_8tmwt")
card = ExtResource("1_qvojs")
metadata/_custom_type_script = "uid://3qpgq1q2rc7j"

[sub_resource type="Resource" id="Resource_okem8"]
script = ExtResource("5_kq8pr")
text = "You sneak behind a boulder to watch what the General does."
next = SubResource("Resource_ekwo1")
metadata/_custom_type_script = "uid://8ly55p71e14f"

[sub_resource type="Resource" id="Resource_8w85p"]
script = ExtResource("2_buo7l")
text = "I'll look over it this once. Leave, and never return."
next = SubResource("Resource_okem8")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_nws1v"]
script = ExtResource("5_kq8pr")
text = "The general is stunned by your boldness and audacity. "
next = SubResource("Resource_8w85p")
metadata/_custom_type_script = "uid://8ly55p71e14f"

[sub_resource type="Resource" id="Resource_uvr5l"]
script = ExtResource("2_buo7l")
text = "..."
next = SubResource("Resource_nws1v")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_snj7c"]
script = ExtResource("2_buo7l")
text = "...Very well. Leave, now. Stop coming back."
next = SubResource("Resource_okem8")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_4euh3"]
script = ExtResource("6_4ivqm")
text1 = "This is where I go to relax and regroup."
option1 = SubResource("Resource_snj7c")
text2 = "I came to confess my love for you."
next = SubResource("Resource_uvr5l")
metadata/_custom_type_script = "uid://uc8ep36gysp7"

[sub_resource type="Resource" id="Resource_c4ju4"]
script = ExtResource("2_buo7l")
text = "You—yet again you find me in these mountains. Why do you keep returning?"
next = SubResource("Resource_4euh3")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_47mdg"]
script = ExtResource("4_47mdg")
metadata/_custom_type_script = "uid://cqduvc147h3nv"

[sub_resource type="Resource" id="Resource_diayr"]
script = ExtResource("2_buo7l")
text = "You are a fool to be carrying this on the royal grounds! "
next = SubResource("Resource_47mdg")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

