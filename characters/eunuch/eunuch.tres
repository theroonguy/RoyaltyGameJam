metadata/_custom_type_script = "uid://3qpgq1q2rc7j"

[sub_resource type="Resource" id="Resource_jm8pl"]
script = ExtResource("1_c3ppw")
text = "You're rather sneaky... take this."
next = SubResource("Resource_xgymu")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_5644a"]
script = ExtResource("1_c3ppw")
text = "You've found yourself in the midst of a grand palace. Show some respect."
next = SubResource("Resource_jm8pl")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_cbab0"]
script = ExtResource("4_xjrel")
text1 = "I'm the new palace helper."
option1 = SubResource("Resource_gdh1g")
text2 = "I'm looking around... I'm a little lost."
option2 = SubResource("Resource_5644a")
metadata/_custom_type_script = "uid://uc8ep36gysp7"

[sub_resource type="Resource" id="Resource_bx41v"]
script = ExtResource("1_c3ppw")
text = "You... who are you?"
next = SubResource("Resource_cbab0")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_ww7v1"]
script = ExtResource("3_xdoq4")
card = ExtResource("7_o8ny7")
metadata/_custom_type_script = "uid://3qpgq1q2rc7j"

[sub_resource type="Resource" id="Resource_sly41"]
script = ExtResource("1_c3ppw")
text = "Now, I have no time for idle chitchat. Hm… you seem familiar."
next = SubResource("Resource_ww7v1")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

[sub_resource type="Resource" id="Resource_7qlye"]
script = ExtResource("4_xjrel")
text1 = "Thanks."
option1 = SubResource("Resource_sly41")
text2 = "Never one to pass up gossip. "
next = SubResource("Resource_sly41")
metadata/_custom_type_script = "uid://uc8ep36gysp7"

[sub_resource type="Resource" id="Resource_vtv1l"]
script = ExtResource("1_c3ppw")
text = "Well, look who it is. It seems you did rather well with the information I provided you. The Empress saw me today, appearing to be in much distress."
next = SubResource("Resource_7qlye")
metadata/_custom_type_script = "uid://bpr0y8ly4cyud"

