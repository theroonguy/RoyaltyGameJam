[sub_resource type="Resource" id="Resource_xdoq4"]
script = ExtResource("2_xjrel")
name = "Love Letter"
desc = "Eunuch Yang gave me this letter indiscreetly... I wonder what's in it?"
metadata/_custom_type_script = "uid://ok0arsecgw2i"

[sub_resource type="Resource" id="Resource_xgymu"]
script = ExtResource("3_xdoq4")
